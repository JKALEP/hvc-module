# ─────────────────────────────────────────────────────────────
# HVC Costos — backend. Plantilla de configuración.
#
# Copiar a `.env` y rellenar. NINGUNA de estas rutas vive en el código:
# si falta una obligatoria, el arranque se detiene diciendo cuál.
#
# `.env` NO se versiona (lleva secretos). Esta plantilla SÍ.
# ─────────────────────────────────────────────────────────────

# ── Obligatorias ──

# Postgres. En despliegue, la cadena que dé el proveedor.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/hvc_costos?schema=public"

# Puerto donde escucha la API.
PORT=3000

# Orígenes que pueden llamar a esta API (CORS). LISTA separada por comas.
#
# ⚠️ Sin valor por defecto en el código: si falta, el backend NO arranca.
# Es a propósito — un respaldo a `localhost` hacía que un despliegue mal
# configurado subiera igual y el frontend real recibiera un CORS que nadie
# sabía de dónde salía.
#
# En desarrollo conviene listar los puertos a los que Vite puede saltar
# cuando el suyo está ocupado.
FRONTEND_URL="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Firma de los JWT. En despliegue, una cadena larga y aleatoria.
# El token solo lleva el `usuarioId`; los permisos se leen de la BD en cada
# petición, así que rotar este secreto solo obliga a volver a entrar.
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"

# ── Semilla del SuperAdmin (`npm run seed:superadmin`) ──
# Se usan UNA vez, al crear la cuenta inicial. No hacen falta en runtime.
SUPERADMIN_EMAIL="admin@empresa.com"
SUPERADMIN_PASSWORD="cambiar-esta-clave"
SUPERADMIN_NOMBRE="SuperAdmin"

# ── Almacenamiento de fotos: Cloudflare R2 ──
# Sin esto el módulo Fotos arranca, pero subir o descargar una foto falla
# con un mensaje que nombra la variable que falta.
# El bucket es PRIVADO: se sirve con URLs firmadas de vencimiento corto.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Opcional: solo si se usa un endpoint distinto del que se deriva de la cuenta.
# R2_ENDPOINT=""

# ── Correo (módulo Costos: enviar solicitudes a proveedores) ──
# Sin RESEND_API_KEY el envío queda en modo desarrollo: NO manda nada,
# devuelve `enviado: false` con el motivo y eso es lo que se guarda en la
# solicitud. Decir «enviado» sin haber enviado dejaría a alguien esperando
# una respuesta imposible.
RESEND_API_KEY=""
# Buzón del dominio verificado con SPF/DKIM en Resend.
CORREO_REMITENTE=""
# Opcional: el nombre que se ve como remitente.
# CORREO_NOMBRE_REMITENTE="HVC Comercial"

# URL pública de la app, para los enlaces que van dentro de los correos
# (invitaciones al portal, avisos de cotización).
URL_APP="http://localhost:5173"
